// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String          @id @default(uuid())
  email         String          @unique
  firstName     String          @map("first_name")
  lastName      String          @map("last_name")
  avatarUrl     String?         @map("avatar_url")
  role          UserRole
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")
  projects      Project[]       @relation("CreatedProjects")
  projectMembers ProjectMember[]
  reportedBugs  Bug[]           @relation("ReportedBugs")
  assignedBugs  Bug[]           @relation("AssignedBugs")
  comments      BugComment[]
  activities    BugActivity[]
  attachments   BugAttachment[]

  @@map("users")
}

enum UserRole {
  ADMIN
  DEVELOPER
  TESTER
  MANAGER

  @@map("user_role")
}

model Project {
  id          String          @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  createdBy   User            @relation("CreatedProjects", fields: [createdById], references: [id])
  createdById String          @map("created_by_id")
  members     ProjectMember[]
  bugs        Bug[]

  @@map("projects")
}

model ProjectMember {
  id        String      @id @default(uuid())
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String      @map("project_id")
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String      @map("user_id")
  role      MemberRole
  createdAt DateTime    @default(now()) @map("created_at")

  @@unique([projectId, userId])
  @@map("project_members")
}

enum MemberRole {
  OWNER
  MEMBER

  @@map("member_role")
}

model Bug {
  id                String          @id @default(uuid())
  title             String
  description       String
  stepsToReproduce  String?         @map("steps_to_reproduce")
  project           Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId         String          @map("project_id")
  status            BugStatus
  priority          BugPriority
  severity          BugSeverity
  reporter          User            @relation("ReportedBugs", fields: [reporterId], references: [id], onDelete: SetNull)
  reporterId        String          @map("reporter_id")
  assignee          User?           @relation("AssignedBugs", fields: [assigneeId], references: [id], onDelete: SetNull)
  assigneeId        String?         @map("assignee_id")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  tags              String[]
  comments          BugComment[]
  activities        BugActivity[]
  attachments       BugAttachment[]

  @@map("bugs")
}

enum BugStatus {
  OPEN
  IN_PROGRESS
  TESTING
  RESOLVED
  CLOSED

  @@map("bug_status")
}

enum BugPriority {
  CRITICAL
  HIGH
  MEDIUM
  LOW

  @@map("bug_priority")
}

enum BugSeverity {
  CRITICAL
  MAJOR
  MINOR
  TRIVIAL

  @@map("bug_severity")
}

model BugComment {
  id        String   @id @default(uuid())
  bug       Bug      @relation(fields: [bugId], references: [id], onDelete: Cascade)
  bugId     String   @map("bug_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId    String   @map("user_id")
  content   String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("bug_comments")
}

model BugActivity {
  id        String   @id @default(uuid())
  bug       Bug      @relation(fields: [bugId], references: [id], onDelete: Cascade)
  bugId     String   @map("bug_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId    String   @map("user_id")
  action    String
  details   String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("bug_activities")
}

model BugAttachment {
  id        String   @id @default(uuid())
  bug       Bug      @relation(fields: [bugId], references: [id], onDelete: Cascade)
  bugId     String   @map("bug_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId    String   @map("user_id")
  fileName  String   @map("file_name")
  fileSize  Int      @map("file_size")
  fileType  String   @map("file_type")
  fileUrl   String   @map("file_url")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("bug_attachments")
}

model Account {
  id                String   @id @default(uuid())
  userId            String   @map("user_id")
  type              String
  provider          String
  providerAccountId String   @map("provider_account_id")
  refresh_token     String?  @db.Text
  access_token      String?  @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?  @db.Text
  session_state     String?
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}
